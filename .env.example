# ===== ENVIRONMENT =====
MOTHER_ENV=local
MOTHER_LOG_LEVEL=INFO
MOTHER_DASHBOARD_ORIGIN=http://localhost:8501

# ===== AUTHENTICATION =====
MOTHER_API_KEY=replace-with-a-random-local-secret
MOTHER_JWT_SECRET=replace-with-a-long-random-local-secret

# ===== STREAMLIT =====
API_BASE=http://localhost:8001
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_SERVER_PORT=8501

# ===== DATABASE =====
# Use your own local or deployment database URL. Never commit credentials.
MOTHER_DB_URL=sqlite:///mother_ai.db

# ===== REDIS =====
MOTHER_REDIS_URL=

# ===== EXCHANGE KEYS =====
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_SANDBOX=true

# ===== TELEGRAM INTEGRATION =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMINS=
TELEGRAM_OPERATORS=

# ===== LINKEDIN =====
LINKEDIN_ACCESS_TOKEN=
LI_CLIENT_ID=
LI_CLIENT_SECRET=
LI_REDIRECT_URI=
LINKEDIN_AUTOPUBLISH=false

# ===== GITHUB =====
GITHUB_TOKEN=

# ===== ADVANCED =====
MOTHER_OTLP_ENDPOINT=
MOTHER_FERNET_KEY=
MOTHER_GATEWAY_URL=
MOTHER_WEBHOOK_URL=
